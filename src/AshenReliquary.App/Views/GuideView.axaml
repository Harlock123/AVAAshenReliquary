<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AshenReliquary.App.ViewModels"
             xmlns:img="using:Avalonia.Media.Imaging"
             x:Class="AshenReliquary.App.Views.GuideView"
             x:DataType="vm:GuideViewModel"
             FontFamily="Georgia, Palatino Linotype, Noto Serif, serif"
             Foreground="#E8DCC4">
  <UserControl.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="Foreground" Value="#F0C860" />
      <Setter Property="LetterSpacing" Value="3" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="#F0C860" />
      <Setter Property="Margin" Value="0,18,0,6" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#DDD1B8" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.tagline">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#E7C98A" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="#A59B87" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#E00E0B0A" />
      <Setter Property="BorderBrush" Value="#5A4C3A" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A3A1E" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E241A" />
    </Style>
    <Style Selector="TextBlock.chapter">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#F0C860" />
    </Style>
    <Style Selector="TextBlock.chapter.sub">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#D8CCB2" />
      <Setter Property="Margin" Value="16,0,0,0" />
    </Style>
    <Style Selector="Button.big">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="#241C16" />
      <Setter Property="BorderBrush" Value="#5A4C3A" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.back">
      <Setter Property="Background" Value="#6B2A12" />
      <Setter Property="Foreground" Value="#FFE7C0" />
      <Setter Property="BorderBrush" Value="#F0A050" />
    </Style>
    <Style Selector="Border.note">
      <Setter Property="Background" Value="#1E1712" />
      <Setter Property="BorderBrush" Value="#8A7238" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style Selector="Border.entry">
      <Setter Property="Background" Value="#15100D" />
      <Setter Property="BorderBrush" Value="#3A3128" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Border.icon">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Background" Value="#3A1A10" />
      <Setter Property="BorderBrush" Value="#8A7238" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid.Background>
      <RadialGradientBrush Center="50%,35%" GradientOrigin="50%,35%" RadiusX="80%" RadiusY="80%">
        <GradientStop Color="#2A1C14" Offset="0" />
        <GradientStop Color="#0B0908" Offset="1" />
      </RadialGradientBrush>
    </Grid.Background>

    <StackPanel Grid.Row="0" Margin="18,8,18,2">
      <TextBlock Classes="h1" Text="THE ASHBOUND'S GUIDE" />
      <TextBlock Classes="dim" Text="How the road from the gallows is walked: the controls, your attributes, the ancestries and classes, and how you fight and grow." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="250,*" Margin="12,4">
      <Border Grid.Column="0" Classes="panel" Padding="0,6">
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Selected}" Name="PageList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GuidePage">
              <TextBlock Classes="chapter" Classes.sub="{Binding IsSub}" Text="{Binding Title}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="panel">
        <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="900" Margin="28,18,28,28" HorizontalAlignment="Left">
            <TextBlock Classes="h1" FontSize="30" Text="{Binding Selected.Title}" Margin="0,0,0,10" />
            <ItemsControl ItemsSource="{Binding Selected.Blocks}" Name="Blocks">
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="vm:GuideHeading">
                  <StackPanel>
                    <TextBlock Classes="h2" Text="{Binding Text}" />
                    <Border Height="1" Background="#5A4C3A" Margin="0,0,0,8" />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuideParagraph">
                  <TextBlock Classes="body" Text="{Binding Text}" />
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuideTagline">
                  <TextBlock Classes="tagline" Text="{Binding Text}" />
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuideNote">
                  <Border Classes="note">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" Foreground="#F0C860" FontSize="13" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <TextBlock Classes="body" Margin="0,1" Text="{Binding}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuideFacts">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,14">
                    <Border Grid.Column="0" IsVisible="{Binding HasPicture}" Width="180" Height="210" Margin="0,0,18,0"
                            Background="#120E0B" BorderBrush="#8A7238" BorderThickness="1" VerticalAlignment="Top">
                      <Image Source="{Binding Picture}" Stretch="None" />
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Facts}" VerticalAlignment="Top">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuideFact">
                          <Grid ColumnDefinitions="140,*" Margin="0,3">
                            <TextBlock Text="{Binding Label}" Foreground="#A59B87" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E8DCC4" FontSize="14" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuidePortraits">
                  <ItemsControl ItemsSource="{Binding Images}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="img:Bitmap">
                        <Border Width="104" Height="104" BorderBrush="#8A7238" BorderThickness="1" Background="#0B0908" Margin="0,0,10,0">
                          <Image Source="{Binding}" Stretch="UniformToFill" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
                <DataTemplate x:DataType="vm:GuideEntry">
                  <Border Classes="entry">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Grid.Column="0" Classes="icon" IsVisible="{Binding HasIcon}">
                        <Image Source="{Binding Icon}" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="15" Foreground="#F3E6CB" />
                          <TextBlock Text="{Binding Meta}" IsVisible="{Binding HasMeta}" FontSize="12" Foreground="#C9A65A" Margin="12,2,0,0" />
                        </StackPanel>
                        <TextBlock Classes="body" Text="{Binding Text}" Margin="0,3,0,0" FontSize="13" LineHeight="19" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="18,4,18,10" LastChildFill="False">
      <Button DockPanel.Dock="Left" Classes="big back" Content="‹  Back" Command="{Binding BackCommand}" Name="BackButton" />
      <Button DockPanel.Dock="Right" Classes="big" Content="Next  ›" Command="{Binding NextCommand}" Name="NextButton" />
      <Button DockPanel.Dock="Right" Classes="big" Content="‹  Previous" Command="{Binding PreviousCommand}" Name="PreviousButton" />
    </DockPanel>
  </Grid>
</UserControl>
