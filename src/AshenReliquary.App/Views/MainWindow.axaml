<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="using:AshenReliquary.App.Rendering"
        xmlns:v="using:AshenReliquary.App.Views"
        x:Class="AshenReliquary.App.Views.MainWindow"
        Title="Ashen Reliquary"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#08070A"
        FontFamily="Georgia, Palatino Linotype, Noto Serif, serif">
  <Panel>
    <r:WorldView x:Name="World" />

    <!-- Escape menu, over the paused game -->
    <Border x:Name="GameMenu" IsVisible="False" Background="#B0000000">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F00E0B0A" BorderBrush="#8A7238"
              BorderThickness="1.5" Padding="28,20">
        <StackPanel>
          <TextBlock Text="Paused" FontSize="24" Foreground="#F0C860" HorizontalAlignment="Center" Margin="0,0,0,12" />
          <Button x:Name="ResumeButton" Content="Resume" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7" />
          <Button x:Name="SaveButton" Content="Save game" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7"
                  ToolTip.Tip="Save over this character's save (F5)." />
          <Button x:Name="SaveCopyButton" Content="Save a copy" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7"
                  ToolTip.Tip="Keep a snapshot of the game as it is now, as a save of its own on the title screen, numbered: Elirk-2, Elirk-3 (F6). Your game still saves to its own file." />
          <Button x:Name="GuideButton" Content="Guide" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7"
                  ToolTip.Tip="How the game plays: the controls, attributes, ancestries, classes, combat and levelling." />
          <Button x:Name="TitleButton" Content="Save and return to title" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7" />
          <Button x:Name="QuitGameButton" Content="Save and quit" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7" />
          <Button x:Name="JustQuitButton" Content="Just quit (don't save)" Width="260" HorizontalContentAlignment="Center" Margin="0,4" FontSize="15" Padding="0,7"
                  ToolTip.Tip="Leave without saving: you go back to your last save or autosave (the last shrine or trader)." />
          <TextBlock Text="Sound" FontSize="15" Foreground="#F0C860" Margin="0,14,0,2" />
          <Grid ColumnDefinitions="80,180" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="Master" VerticalAlignment="Center" Foreground="#C8BCA4" />
            <Slider Grid.Row="0" Grid.Column="1" x:Name="MasterSlider" Minimum="0" Maximum="1" />
            <TextBlock Grid.Row="1" Text="Effects" VerticalAlignment="Center" Foreground="#C8BCA4" />
            <Slider Grid.Row="1" Grid.Column="1" x:Name="EffectsSlider" Minimum="0" Maximum="1" />
            <TextBlock Grid.Row="2" Text="Music" VerticalAlignment="Center" Foreground="#C8BCA4" />
            <Slider Grid.Row="2" Grid.Column="1" x:Name="MusicSlider" Minimum="0" Maximum="1" />
            <TextBlock Grid.Row="3" Text="Ambience" VerticalAlignment="Center" Foreground="#C8BCA4" />
            <Slider Grid.Row="3" Grid.Column="1" x:Name="AmbienceSlider" Minimum="0" Maximum="1" />
          </Grid>
          <TextBlock x:Name="SoundNote" Foreground="#E8695E" FontSize="11" TextWrapping="Wrap" MaxWidth="260" />
          <TextBlock Text="Loot" FontSize="15" Foreground="#F0C860" Margin="0,14,0,2" />
          <CheckBox x:Name="HideCommonLoot" Content="Hide common gear on the ground (hold Alt to see it)" Foreground="#C8BCA4" />
          <TextBlock x:Name="MenuNote" Foreground="#A59B87" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </Border>

    <v:CharacterCreationView x:Name="Creation" IsVisible="False" />
    <v:GuideView x:Name="Guide" IsVisible="False" />
    <v:TitleView x:Name="TitlePage" IsVisible="False" />
  </Panel>
</Window>
